# ==============================================================================
# TVU Books & Materials - Environment Variables Template
# Copy this file to .env and insert your real keys
# ==============================================================================

# 1. Gemini API Key (Obtain free API key from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_gemini_api_key_here

# 2. AI Provider Configuration ('gemini' or 'groq')
AI_PROVIDER=gemini

# 3. Model Name
# - Gemini options: gemini-3.5-flash (recommended), gemini-3.7-flash, gemini-flash-latest
# - Groq options: llama-3.3-70b-versatile, mixtral-8x7b-32768
AI_MODEL=gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash

# 4. Local Server Port
PORT=3000

# 5. Firebase Project Configuration
FIREBASE_PROJECT_ID=ecomerce-23100

# 6. Optional Firebase Admin SDK Credentials for Server-side Token & Database Verification
# (Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key)
# Option A: Individual Variables
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@ecomerce-23100.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option B (Alternative): Single JSON string of service account key
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"ecomerce-23100",...}
