rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // WEBSITE OWNER: replace with your own verified email(s). Only these accounts (and any
    // account listed in the admins collection by an existing admin) can use the admin dashboard.
    function isOwnerEmail() {
      return isAuthenticated() &&
             request.auth.token.email_verified == true &&
             request.auth.token.email in ['REPLACE_WITH_OWNER_EMAIL@gmail.com'];
    }

    function isAdmin() {
      return isAuthenticated() && (
        isOwnerEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 1. Customer Profiles: customers/{uid}
    // Any authenticated user can read profiles; only owner can create/update
    match /customers/{uid} {
      allow read: if isAuthenticated();
      // Users can never promote themselves: role stays "customer"
      allow create: if isOwner(uid) && request.resource.data.get('role', 'customer') == 'customer';
      allow update: if isOwner(uid) &&
                       request.resource.data.get('role', 'customer') == resource.data.get('role', 'customer');
      allow delete: if false;
    }

    // 2. Seller Profiles: sellers/{uid}
    // Any authenticated user can view seller details; only owner can create/update
    match /sellers/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // 3. Books Marketplace: books/{bookId}
    // Public read so students can browse books; only owner seller can modify/delete
    match /books/{bookId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.sellerId == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'availability', 'updatedAt']))
      );
      allow delete: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // 4. User Wishlist: users/{uid}/wishlist/{bookId}
    // Strictly private to each user
    match /users/{uid}/wishlist/{bookId} {
      allow read, write: if isOwner(uid);
    }

    // 4b. User Cart: users/{uid}/cart/{bookId}
    // Strictly private to each user
    match /users/{uid}/cart/{bookId} {
      allow read, write: if isOwner(uid);
    }

    // 5. Orders: orders/{orderId}
    // Customers create orders for themselves; visible only to buyer and seller
    match /orders/{orderId} {
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.sellerId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 6. Admin Registry: admins/{uid}
    // Read allowed for authenticated users to verify authorization state; write restricted to existing admins
    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // 7. Academic Syllabuses: syllabuses/{syllabusId}
    // Public read for students to download; strictly managed by verified administrators
    match /syllabuses/{syllabusId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 8. Previous Year Question Papers: questionPapers/{questionPaperId}
    // - Public read: only approved & active papers
    // - Admin read: all papers (pending, approved, rejected)
    // - Submitter read: own submissions
    // - Create: authenticated users can submit with status 'pending'
    // - Update / Delete / Approve / Reject: strictly verified administrators
    match /questionPapers/{questionPaperId} {
      allow read: if (resource.data.status == 'approved' && resource.data.isActive == true) ||
                     isAdmin() ||
                     (isAuthenticated() && resource.data.uploadedBy == request.auth.uid);
      allow create: if isAuthenticated() &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
